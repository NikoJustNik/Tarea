//Tarea de ejercicios bosquejo y PseInt
//Solicitar al usuario un carácter y mostrar si es una vocal
Algoritmo ejercicio_de_practica_Nro13
	definir letra Como Caracter
	escribir "ingrese una letra, por favor..."
	leer letra
	Escribir "verificando si es una vocal"
	si letra = "a" o letra = "e" o letra = "i" o letra = "o" o letra = "u" o letra = "A" o letra = "E" o letra = "I" o letra = "O" o letra = "U" Entonces
		escribir letra, " es una vocal"
	SiNo
		escribir letra, " no es una vocal"
		
	FinSi
FinAlgoritmo
