//Tarea de ejercicios bosquejo y PseInt
//Pedir al usuario un número y mostrar si es mayor o menor que 10.
Algoritmo ejercicio_de_practica_Nro11
	definir num Como Real
	escribir "ingrese un numero, por favor..."
	leer num
	escribir "verificando si es mayor o menor que 10"
	si num > 10 Entonces
		Escribir num," > 10"
		escribir num, " es mayor que 10"
	SiNo
		Escribir num," < 10"
		escribir num, " es menor que 10"
	FinSi
FinAlgoritmo
