//Tarea de ejercicios bosquejo y PseInt
//Solicitar al usuario un número y mostrar si es un número de un solo dígito.
Algoritmo ejercicio_de_practica_Nro16
	definir num como entero 
	escribir "ingrese un numero, por favor..."
	leer num
	escribir "verificando si ", num , " es un número de un solo dígito."
	si num >= -9 y num <= 9 Entonces
		escribir num, " es de un dijito"
	SiNo
		escribir num, " no es de un dijito"
	FinSi
	
FinAlgoritmo
