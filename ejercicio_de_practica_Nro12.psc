//Tarea de ejercicios bosquejo y PseInt
//Solicitar al usuario su edad y mostrar si es mayor o menor de edad. 
Algoritmo ejercicio_de_practica_Nro12
	definir edad Como Entero
	escribir "ingrese su edad, por favor..."
	leer edad
	escribir "verificando si es mayor de edad..."
	si edad > 18 Entonces
		escribir "si eres mayor de edad"
	SiNo
		escribir "no eres mayor de edad"
	FinSi
FinAlgoritmo
